<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="XamarinFormsEnablerMobile.ServerConfigurationPage"
             BackgroundColor="AliceBlue">
    <ContentPage.Content>
        <ScrollView VerticalOptions="CenterAndExpand" HorizontalOptions="FillAndExpand" Padding="20" Orientation="Vertical">
            <StackLayout>
                <Label HorizontalOptions="Center" x:Name="Serial" Text="Device ID"/>
                <!-- <Label Text="Current server: " HorizontalOptions="Center" x:Name="CurrentServer"/> -->
                <Frame Padding="7" CornerRadius="10">
                    <StackLayout Orientation="Horizontal">
                        <Label Text="Laravel API"/>
                        <Switch Toggled="SetAPIType" HorizontalOptions="EndAndExpand" x:Name="APISwitch"/>
                    </StackLayout>
                </Frame>
                <Frame Padding="7" CornerRadius="10">
                    <StackLayout Orientation="Horizontal">
                        <StackLayout HorizontalOptions="FillAndExpand">
                            <Label Text="API Server"/>
                            <Entry MinimumWidthRequest="200" Placeholder="..." x:Name="ServerField" HorizontalTextAlignment="Center" HorizontalOptions="FillAndExpand" />
                        </StackLayout>
                        <StackLayout  HorizontalOptions="FillAndExpand">
                            <Label Text="API Port"/>
                            <Entry  x:Name="ConfigurationPort" HorizontalOptions="FillAndExpand" HorizontalTextAlignment="Center" Placeholder="..."  />
                        </StackLayout>
                    </StackLayout>
                </Frame>

                <Frame CornerRadius="10" Padding="10" VerticalOptions="Start" HorizontalOptions="FillAndExpand" >
                    <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand" VerticalOptions="Center">
                        <Label Text="Use Fuel Products" HorizontalOptions="StartAndExpand" VerticalTextAlignment="Center"/>
                        <Switch IsToggled="{Binding  main.appSettings.EnableFuels}" x:Name="EnableFuelsSwitch" Toggled="SetTempUseFuels" OnColor="SeaGreen" ThumbColor="DarkGray" HorizontalOptions="End"/>
                    </StackLayout>
                </Frame>

                <Frame CornerRadius="10" Padding="10" VerticalOptions="Start" HorizontalOptions="FillAndExpand" IsVisible="{Binding main.appSettings.showServiceChargeDB}">
                    <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand" VerticalOptions="Center">
                        <Label Text="Use DB Auto Service Charge" HorizontalOptions="StartAndExpand" VerticalTextAlignment="Center"/>
                        <Switch IsToggled="{Binding  main.appSettings.DBApplyServiceCharge}" x:Name="AutoServiceChargeSwitch" Toggled="SetTempUseDBServiceCharge" OnColor="SeaGreen" ThumbColor="DarkGray" HorizontalOptions="End"/>
                    </StackLayout>
                </Frame>

                <Frame Padding="7" CornerRadius="10" IsVisible="{Binding  main.appSettings.EnableFuels}">
                    <StackLayout>
                        <Label Text="Enabler Server"/>
                        <Entry WidthRequest="270"
                               Placeholder="..."
                               x:Name="EnablerServerField"
                               HorizontalTextAlignment="Center"
                               Text="{Binding main.terminalServer}"/>
                    </StackLayout>
                </Frame>
                <StackLayout Orientation="Horizontal" >
                    <Frame Padding="7"
                           CornerRadius="10"
                           HorizontalOptions="FillAndExpand" IsVisible="{Binding  main.appSettings.EnableFuels}">
                        <StackLayout  >
                            <Label Text="Enabler Terminal" />
                            <Entry WidthRequest="135"
                                   Placeholder="..."
                                   x:Name="EnablerTerminalField"
                                   HorizontalTextAlignment="Center"
                                    />
                        </StackLayout>
                    </Frame>
                    
                    <Frame Padding="7"
                           CornerRadius="10"
                           HorizontalOptions="FillAndExpand">
                        <StackLayout>
                            <Label Text="POS ID" />
                            <Entry WidthRequest="135"
                                   Placeholder="..."
                                   x:Name="posIDField"
                                   HorizontalTextAlignment="Center"
                                    />
                        </StackLayout>
                    </Frame>
                </StackLayout>
                <Frame Padding="7" CornerRadius="10" IsVisible="{Binding  main.appSettings.EnableFuels}">
                    <StackLayout>
                        <Label Text="Enabler Password"/>
                        <Entry WidthRequest="270" Placeholder="..." x:Name="EnablerPasswordField" HorizontalTextAlignment="Center" IsPassword="True" />
                    </StackLayout>
                </Frame>

                <StackLayout Orientation="Horizontal"  IsVisible="{Binding  main.appSettings.EnableFuels}">
                    <Frame Padding="7"
                           CornerRadius="10"
                           HorizontalOptions="FillAndExpand">
                        <StackLayout>
                            <Label Text="Pump Start" />
                            <Entry MinimumWidthRequest="135"
                                   Placeholder="..."
                                   x:Name="PumpStartField"
                                   HorizontalTextAlignment="Center"
                                   Text="1"
                                   />
                        </StackLayout>
                    </Frame>

                    <Frame Padding="7"
                           CornerRadius="10"
                           HorizontalOptions="FillAndExpand">
                        <StackLayout>
                            <Label Text="Pump End" />
                            <Entry MinimumWidthRequest="135"
                                   Placeholder="..."
                                   x:Name="PumpEndField"
                                   HorizontalTextAlignment="Center"
                                   Text="8" />
                        </StackLayout>
                    </Frame>
                </StackLayout>
                
                <Frame Padding="7" CornerRadius="10">
                    <StackLayout>
                        <Label Text="Admin ID"/>
                        <Entry WidthRequest="270" Placeholder="..." x:Name="AdminIDField" HorizontalTextAlignment="Center"/>
                    </StackLayout>
                </Frame>
                <Frame Padding="7" CornerRadius="10">
                    <StackLayout>
                        <Label Text="Admin Password"/>
                        <Entry WidthRequest="270" Placeholder="..." x:Name="AdminPasswordField" HorizontalTextAlignment="Center" IsPassword="True"/>
                    </StackLayout>
                </Frame>
                <Button Text="Save" Clicked="EnablerConfigurationButtonOnClick" CornerRadius="10"/>
                <Button Text="Close" Clicked="BackToLoginPage" CornerRadius="10"/>
            </StackLayout>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>