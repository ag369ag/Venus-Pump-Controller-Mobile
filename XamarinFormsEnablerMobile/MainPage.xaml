<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="XamarinFormsEnablerMobile.MainPage"
             Visual="Material">
    <StackLayout BackgroundColor="AliceBlue"
                 VerticalOptions="FillAndExpand"
                 HorizontalOptions="FillAndExpand"
                 Padding="20"
                 x:Name="mainPageStackLayout"
                 Orientation="Vertical">
        <Button CornerRadius="100"
                Padding="0"
                WidthRequest="50"
                VerticalOptions="Start"
                HorizontalOptions="End"
                Clicked="ConfigureServer"
                ImageSource="settings_icon" />

        <StackLayout Margin="0,50,0,0"
                     VerticalOptions="CenterAndExpand"
                     HorizontalOptions="CenterAndExpand">
            <Label Text="Venus Pump Controller"
                   FontSize="26"
                   FontAttributes="Bold"
                   TextColor="DarkCyan"
                   HorizontalTextAlignment="Center" />
            <Label Text="Mobile POS"
                   FontSize="26"
                   FontAttributes="Bold"
                   TextColor="DarkCyan"
                   HorizontalTextAlignment="Center" />
            
            
            
            <Label x:Name="OfflineIndicator"
                   FontSize="20"
                   Text=""
                   FontAttributes="Bold"
                   TextColor="Red"
                   HorizontalTextAlignment="Center" />

        </StackLayout>

        <Frame BackgroundColor="Transparent"
               Padding="10"
               CornerRadius="10"
               HorizontalOptions="Center"
               VerticalOptions="EndAndExpand"
               Margin="0,0,0,30">
            <StackLayout>
                <Frame Padding="7"
                       CornerRadius="10"
                       BackgroundColor="White">
                    <StackLayout>
                        <Label Text="User ID" />
                        <Entry WidthRequest="270"
                               HeightRequest="50"
                               Placeholder="Cashier ID"
                               x:Name="UserIDField"
                               HorizontalTextAlignment="Center" />
                    </StackLayout>
                </Frame>
                <Frame Padding="7"
                       CornerRadius="10"
                       BackgroundColor="White">
                    <StackLayout>
                        <Label Text="User Password" />
                        <Entry WidthRequest="270"
                               HeightRequest="50"
                               Placeholder="Password"
                               IsPassword="True"
                               x:Name="UserPasswordField"
                               HorizontalTextAlignment="Center" />
                    </StackLayout>
                </Frame>
                <Button
                    x:Name="connectButton" Margin="20"
                        CornerRadius="10"
                        Text="Connect"
                        Clicked="ConnectButtonOnClicked" />
            </StackLayout>
        </Frame>

        <Label Text="Version: 1.0.0.0"
               HorizontalOptions="CenterAndExpand" />

    </StackLayout>

</ContentPage>
